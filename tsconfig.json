{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@cms/*": ["./cms/src/*"],
      "@desktop/*": ["./desktop/src/*"]
    },
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "files": [],
  "references": [
    { "path": "./cms" },
    { "path": "./desktop" }
  ]
}
