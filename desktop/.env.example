# ==============================================================================
# FOTOLISM DESKTOP — CẤU HÌNH ĐỊA CHỈ CLOUD CMS (EXAMPLE)
# Copy thành .env hoặc .env.local và chỉnh sửa URL khi cần test
#   - Production / Deploy Vercel : https://fotolism-cms.vercel.app
#   - Localhost Development      : http://localhost:3000
# ==============================================================================

# Biến môi trường Vite (Client-side Frontend)
VITE_CMS_STAGING_URL=https://fotolism-cms.vercel.app
VITE_CMS_URL=https://fotolism-cms.vercel.app

# Biến môi trường Node / Electron (Background Worker & Scripts)
CMS_STAGING_URL=https://fotolism-cms.vercel.app
CMS_URL=https://fotolism-cms.vercel.app
