{
  "name": "fotolism-desktop",
  "productName": "fotolism",
  "private": true,
  "version": "0.1.10",
  "description": "AI-Powered Photobooth Software",
  "type": "module",
  "author": "fotolism team",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on -t 30000 tcp:127.0.0.1:5173 && cmd /c \"set ELECTRON_RUN_AS_NODE=&& set NODE_ENV=development&& electron .\"",
    "dev:ai": "cd ai-service && python main.py",
    "dev": "concurrently -n vite,ai,electron -c cyan,magenta,yellow \"npm run dev:vite\" \"npm run dev:ai\" \"npm run dev:electron\"",
    "dev:vite:photobooth": "cross-env VITE_KIOSK_MODE=photobooth vite",
    "dev:vite:selfbooth": "cross-env VITE_KIOSK_MODE=selfbooth vite",
    "dev:electron:photobooth": "wait-on -t 30000 tcp:127.0.0.1:5173 && cmd /c \"set ELECTRON_RUN_AS_NODE=&& set NODE_ENV=development&& set VITE_KIOSK_MODE=photobooth&& set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "dev:electron:selfbooth": "wait-on -t 30000 tcp:127.0.0.1:5173 && cmd /c \"set ELECTRON_RUN_AS_NODE=&& set NODE_ENV=development&& set VITE_KIOSK_MODE=selfbooth&& set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "dev:photobooth": "concurrently -n vite,ai,electron -c cyan,magenta,yellow \"npm run dev:vite:photobooth\" \"npm run dev:ai\" \"npm run dev:electron:photobooth\"",
    "dev:selfbooth": "concurrently -n vite,ai,electron -c cyan,magenta,yellow \"npm run dev:vite:selfbooth\" \"npm run dev:ai\" \"npm run dev:electron:selfbooth\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "build:ai": "cd ai-service && python -m PyInstaller --noconfirm fotolism_ai_service.spec",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:win": "npm run build:ai && npm run build && electron-builder --win --publish never",
    "release:win": "npm run build:ai && npm run build && electron-builder --win --publish always",
    "preview": "vite preview",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.10.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.fotolism.desktop",
    "productName": "fotolism",
    "electronVersion": "44.10.2",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hadesnguyen123",
        "repo": "fotolism-releases"
      }
    ],
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "electron",
        "to": "canon-daemon",
        "filter": [
          "fotolism_canon_daemon.exe",
          "fotolism_canon_capture.exe",
          "canon_edsdk_capture.ps1",
          "EDSDK.dll",
          "EdsImage.dll"
        ]
      },
      {
        "from": "ai-service/dist/fotolism_ai_service",
        "to": "ai-service"
      },
      {
        "from": "public/mediapipe/models/face_landmarker.task",
        "to": "mediapipe/models/face_landmarker.task"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.photography",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}