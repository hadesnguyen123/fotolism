{
  "name": "fotolism-root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "cms",
    "desktop"
  ],
  "description": "Fotolism Photobooth Software Suite",
  "scripts": {
    "dev": "npm --prefix desktop run dev",
    "build": "npm --prefix desktop run build",
    "build:mac": "npm --prefix desktop run build:mac",
    "build:win": "npm --prefix desktop run build:win",
    "start": "npm --prefix desktop start",
    "preview": "npm --prefix desktop run preview",
    "cms": "npm --prefix cms run dev",
    "cms:build": "npm --prefix cms run build",
    "cms:test": "npm --prefix cms test",
    "verify": "node .agents/skills/joybooth-system-verifier/scripts/verify-all.mjs",
    "test": "npm --prefix desktop test && npm --prefix cms test",
    "ai": "cd desktop/ai-service && python main.py"
  }
}
